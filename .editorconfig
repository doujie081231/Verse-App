root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts,java,c,cpp,h,hpp,xml,json}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Preserve the indentation style of vendored source files.
[FclCore/src/**]
indent_style = unset
indent_size = unset

[VerseApp/src/main/java/net/kdt/**]
indent_style = unset
indent_size = unset

[VerseLauncher/src/main/java/com/verse/explorer/launcher/fcl/**]
indent_style = unset
indent_size = unset
